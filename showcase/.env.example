# Grok assistant
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_FREE_QUESTIONS=5
XAI_DAILY_BUDGET=200

# Admin sign-in (#/admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address, used for the M-Pesa callback and bot update links
SITE_URL=https://llsbot.malimines.com

# PayPal (card + PayPal). Add PAYPAL_ENV=sandbox only for sandbox keys.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayHero M-Pesa. Any one of these logins; PAYHERO_BASIC_TOKEN is tried last.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_BASIC_AUTH=
PAYHERO_BASIC_TOKEN=
PAYHERO_CHANNEL_ID=8561

# Cloud bot (24/7 on Google Cloud Run). worker/deploy.ps1 prints both values.
# Same 32-byte base64 key here and on the worker; it seals customers' Deriv tokens.
CLOUD_BOT_KEY=
# Service-account JSON (raw or base64) with Firestore access, for the site's /api/account/cloud-bot routes.
FIREBASE_SERVICE_ACCOUNT=
