    "check-repo-safe": "tsx scripts/check-repo-safe.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "check-connection": "tsx --env-file=.env scripts/check-connection.ts",
    "check-auth": "tsx --env-file=.env scripts/check-auth.ts",
    "check-buy": "tsx --env-file=.env scripts/check-buy.ts",
    "check-payout": "tsx --env-file=.env scripts/check-payout.ts",
    "check-cycle": "tsx --env-file=.env scripts/check-cycle.ts",
    "check-edge": "tsx --env-file=.env scripts/check-edge.ts",
    "check-differs": "tsx --env-file=.env scripts/check-differs.ts",
    "find-edge": "tsx --env-file=.env scripts/find-edge.ts",
    "check-accounts": "tsx --env-file=.env scripts/check-accounts.ts",
    "check-coldpick": "tsx --env-file=.env scripts/check-coldpick.ts",
    "check-exit": "tsx --env-file=.env scripts/check-exit.ts",
    "diagnose-gate": "tsx --env-file=.env scripts/diagnose-gate.ts",
    "probe-elite": "tsx --env-file=.env scripts/probe-elite.ts",
    "calibrate-elite": "tsx --env-file=.env scripts/calibrate-elite.ts",
    "run-bot": "tsx --env-file=.env scripts/run-bot.ts",
    "quick-trade": "tsx --env-file=.env scripts/quick-trade.ts",
    "fetch-ticks": "tsx --env-file=.env scripts/fetch-ticks.ts",
    "backtest": "tsx scripts/backtest.ts",
    "verify-backtest": "tsx scripts/verify-backtest.ts",
    "check-exposure": "tsx scripts/check-exposure.ts",
    "check-settle-stream": "tsx --env-file=.env scripts/check-settle-stream.ts",
    "check-demo-vs-real": "tsx --env-file=.env scripts/check-demo-vs-real.ts",
    "check-beststake": "tsx --env-file=.env scripts/check-beststake.ts",
    "check-overunder": "tsx --env-file=.env scripts/check-overunder.ts",
    "check-plan-gate": "tsx --env-file=.env scripts/check-plan-gate.ts",
    "research": "tsx --env-file=.env scripts/research-real.ts",
    "atlas:smoke": "tsx scripts/atlas-smoke.ts",
    "atlas:api": "cd atlas/api && python -m uvicorn app.main:app --reload --port 8787"
