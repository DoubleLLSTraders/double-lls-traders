{
  "name": "double-lls-traders",
  "private": true,
  "description": "Double LLS Traders — secured Deriv Matches / Differs trading desk",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
