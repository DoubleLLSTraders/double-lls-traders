# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. Never commit real tokens.

# ---------------------------------------------------------------------------
# Deriv connection
# ---------------------------------------------------------------------------

# app_id from the Deriv developer portal registration form.
VITE_DERIV_APP_ID=

# Deriv WebSocket endpoint. Leave as-is unless Deriv publishes a new host.
VITE_DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# ---------------------------------------------------------------------------
# API tokens (scopes: Read + Trade only)
# ---------------------------------------------------------------------------

# Token for the VIRTUAL / demo account. All development runs against this.
VITE_DERIV_TOKEN_DEMO=

# Token for the REAL-money account. Leave blank until the bot has been proven
# on demo. An empty value here makes it impossible to trade real money by
# accident.
VITE_DERIV_TOKEN_REAL=pat_b14a7040457d49600636670d721c5188d8bca8b595b99d601edbb121cbcd5ae9

# ---------------------------------------------------------------------------
# Trading defaults
# ---------------------------------------------------------------------------

# demo | real — which token above the app connects with.
VITE_DERIV_ACCOUNT=demo

# paper  = analyse and log signals, place no orders at all
# live   = actually send buy requests to Deriv
VITE_TRADING_MODE=paper

# Synthetic index to stream and trade.
VITE_DEFAULT_SYMBOL=R_100

# ---------------------------------------------------------------------------
# Risk limits — the bot refuses to trade once any of these is breached.
# Sized for a small account on purpose, so demo results transfer to real.
# ---------------------------------------------------------------------------

VITE_BASE_STAKE=0.35
VITE_MAX_STAKE=2
VITE_DAILY_LOSS_LIMIT=5
VITE_DAILY_PROFIT_TARGET=5
VITE_MAX_CONSECUTIVE_LOSSES=5
VITE_MAX_TRADES_PER_DAY=100
