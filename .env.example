# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. Never commit real tokens.

# ---------------------------------------------------------------------------
# Deriv connection (new Options API — PAT + REST + OTP WebSocket)
# ---------------------------------------------------------------------------

# App ID from the Deriv developer dashboard (Brick Trader).
VITE_DERIV_APP_ID=

VITE_DERIV_REST_URL=https://api.derivws.com

# ---------------------------------------------------------------------------
# API tokens (PAT from home.deriv.com → profile → API tokens)
# ---------------------------------------------------------------------------

# Demo / virtual account token. All development runs against this.
VITE_DERIV_TOKEN_DEMO=

# Real account token. Required before switching to Live account in Settings.
VITE_DERIV_TOKEN_REAL=

# Demo account id from GET /trading/v1/options/accounts (starts with DOT).
VITE_DERIV_DEMO_ACCOUNT_ID=

# Real account id — pin the exact account (strongly recommended for live).
VITE_DERIV_REAL_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Trading defaults
# ---------------------------------------------------------------------------

# demo | real — which token above the app connects with on first load.
# The Settings modal can switch demo/real at runtime without a rebuild.
VITE_DERIV_ACCOUNT=demo

# paper  = analyse and paper-trade locally (no buy requests)
# live   = send real DIGITMATCH / DIGITDIFF buys on the connected account
#          (prove on demo account first, then switch account in Settings)
# Requires dev-server restart after changing.
VITE_TRADING_MODE=paper

# Synthetic index to stream and trade (R_75 recommended for Differs payout).
VITE_DEFAULT_SYMBOL=R_75

# ---------------------------------------------------------------------------
# Risk limits — seed defaults for the Bot form (session caps in the UI).
# ---------------------------------------------------------------------------

VITE_BASE_STAKE=0.35
VITE_MAX_STAKE=2
VITE_DAILY_LOSS_LIMIT=5
VITE_DAILY_PROFIT_TARGET=5
VITE_MAX_CONSECUTIVE_LOSSES=5
VITE_MAX_TRADES_PER_DAY=100
